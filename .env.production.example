# LIFE.SAVER v0.4.0 production environment template
# Never commit real .env. Put real values in your hosting provider's environment-variable panel.

NODE_ENV=production
PORT=4000
FRONTEND_URL=https://app.yourdomain.com
PUBLIC_SITE_URL=https://yourdomain.com
APP_URL=https://app.yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
API_URL=https://api.yourdomain.com
PRODUCT_SURFACE_MODE=subdomain-production-ready
DOMAIN_DEPLOYMENT_MODE=split-subdomain-production
CUSTOMER_ACCESS_MODE=private-beta
CUSTOMER_LAUNCH_DOMAIN_LABEL=LIFE.SAVER Private Beta
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com,https://admin.yourdomain.com

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true

# Production auth/security. Use long random values. Do not reuse development values.
AUTH_TOKEN_SECRET=replace_with_64_plus_random_chars
AUTH_TOKEN_TTL_SECONDS=28800
APP_ENCRYPTION_KEY=replace_with_64_plus_random_chars_do_not_rotate_after_keys_are_stored
WORKER_SHARED_SECRET=replace_with_64_plus_random_chars

DASHBOARD_REQUIRE_AUTH=true
CHAT_REQUIRE_AUTH=true
API_RATE_LIMIT_PER_MINUTE=300
CHAT_RATE_LIMIT_PER_MINUTE=10
JSON_BODY_LIMIT=1mb
ENABLE_DEBUG_ROUTES=false
ALLOW_INSECURE_PRODUCTION_STARTUP=false

# Claude server-side only
CLAUDE_API_KEY=
CLAUDE_API_BASE_URL=https://api.anthropic.com
CLAUDE_API_VERSION=2023-06-01
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=700
CLAUDE_TEMPERATURE=0.35
CLAUDE_DAILY_CHAT_LIMIT=100
CLAUDE_TOOL_MAX_CALLS=3
DAILY_CLAUDE_COST_LIMIT_USD=10
DRAFT_DAILY_LIMIT=100
MAX_CHAT_HISTORY_MESSAGES=12

# Triple Whale read-only API
TRIPLE_WHALE_API_BASE_URL=https://api.triplewhale.com
TRIPLE_WHALE_VALIDATE_PATH=/api/v2/users/api-keys/me
TRIPLE_WHALE_SUMMARY_PATH=/api/v2/summary-page/get-data
TRIPLE_WHALE_SUMMARY_BODY_JSON=
TRIPLE_WHALE_SHOP_DOMAIN=budclub.com
TRIPLE_WHALE_ADDITIONAL_SHOP_IDS=budclub.com
TRIPLE_WHALE_CURRENCY=USD
TRIPLE_WHALE_TIMEZONE=America/New_York
TRIPLE_WHALE_TIMEZONE_OFFSET=-04:00
TRIPLE_WHALE_SUMMARY_DATE=
TRIPLE_WHALE_SUMMARY_GROUP_BY=hour
TRIPLE_WHALE_TODAY_HOUR=
TRIPLE_WHALE_ATTRIBUTION_PATH=/api/v2/attribution/get-orders-with-journeys-v2
TRIPLE_WHALE_ATTRIBUTION_BODY_JSON=
TRIPLE_WHALE_ATTRIBUTION_DATE=
TRIPLE_WHALE_ATTRIBUTION_PAGE=1
TRIPLE_WHALE_ATTRIBUTION_PAGE_SIZE=25
TRIPLE_WHALE_ATTRIBUTION_EXCLUDE_JOURNEY_DATA=true
TRIPLE_WHALE_LIVE_TEST_URL=

# Worker process
WORKER_ENABLED=false
WORKER_API_BASE_URL=https://api.yourdomain.com
WORKER_TIMEZONE=America/New_York
WORKER_METRICS_CRON=15 * * * *
WORKER_DAILY_BRIEF_CRON=30 8 * * *
WORKER_WEEKLY_SUMMARY_CRON=0 9 * * 1
WORKER_WORKSPACE_ID=
WORKER_USER_ID=

# v0.4.3 Environment Separation
APP_ENVIRONMENT=production
DATABASE_ENVIRONMENT=production
ENVIRONMENT_LOCK=production:production
PRODUCTION_DATABASE_URL=postgresql://PROD_USER:PROD_PASSWORD@PROD_HOST:5432/postgres

SAAS_SIGNUP_ENABLED=true
