# LIFE.SAVER Render/Railway style production environment template
# Place these values in the hosting dashboard, not in GitHub.
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://app.yourdomain.com
PUBLIC_SITE_URL=https://yourdomain.com
APP_URL=https://app.yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
API_URL=https://api.yourdomain.com
PRODUCT_SURFACE_MODE=subdomain-production-ready
DOMAIN_DEPLOYMENT_MODE=split-subdomain-production
CUSTOMER_ACCESS_MODE=private-beta
CUSTOMER_LAUNCH_DOMAIN_LABEL=LIFE.SAVER Private Beta
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com,https://admin.yourdomain.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true
AUTH_TOKEN_SECRET=replace_with_long_random_secret
APP_ENCRYPTION_KEY=replace_with_long_random_secret_keep_stable
WORKER_SHARED_SECRET=replace_with_long_random_secret
DASHBOARD_REQUIRE_AUTH=true
CHAT_REQUIRE_AUTH=true
ENABLE_DEBUG_ROUTES=false
API_RATE_LIMIT_PER_MINUTE=300
JSON_BODY_LIMIT=1mb
CLAUDE_API_KEY=replace_in_hosting_secret_manager
CLAUDE_API_BASE_URL=https://api.anthropic.com
CLAUDE_API_VERSION=2023-06-01
CLAUDE_MODEL=claude-sonnet-4-20250514
TRIPLE_WHALE_API_BASE_URL=https://api.triplewhale.com
TRIPLE_WHALE_VALIDATE_PATH=/api/v2/users/api-keys/me
TRIPLE_WHALE_SUMMARY_PATH=/api/v2/summary-page/get-data
TRIPLE_WHALE_SHOP_DOMAIN=budclub.com
TRIPLE_WHALE_ADDITIONAL_SHOP_IDS=budclub.com
TRIPLE_WHALE_CURRENCY=USD
TRIPLE_WHALE_TIMEZONE=America/New_York
TRIPLE_WHALE_TIMEZONE_OFFSET=-04:00
WORKER_API_BASE_URL=https://api.yourdomain.com
WORKER_ENABLED=false

SAAS_SIGNUP_ENABLED=true
