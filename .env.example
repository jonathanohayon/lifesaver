# LIFE.SAVER safe local development environment example
# Copy this file to .env, then replace placeholders with your own private values.
# Never commit or upload a real .env containing real database passwords/API keys.

NODE_ENV=development
APP_ENVIRONMENT=development
DATABASE_ENVIRONMENT=development
ENVIRONMENT_LOCK=development:development
PORT=4000
FRONTEND_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000/landing.html
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin.html
API_URL=http://localhost:4000
PRODUCT_SURFACE_MODE=single-service-local
DOMAIN_DEPLOYMENT_MODE=local-development
CUSTOMER_ACCESS_MODE=local-testing
CUSTOMER_LAUNCH_DOMAIN_LABEL=LIFE.SAVER Local
ALLOWED_ORIGINS=http://localhost:3000
SERVE_WEB_APP=false
SAAS_SIGNUP_ENABLED=true

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true

AUTH_TOKEN_SECRET=replace_with_long_random_auth_secret_32_chars_minimum
AUTH_TOKEN_TTL_SECONDS=28800
APP_ENCRYPTION_KEY=replace_with_stable_long_random_encryption_key

DASHBOARD_REQUIRE_AUTH=false
CHAT_REQUIRE_AUTH=false
API_RATE_LIMIT_PER_MINUTE=300
JSON_BODY_LIMIT=1mb

CLAUDE_API_KEY=
CLAUDE_API_BASE_URL=https://api.anthropic.com
CLAUDE_API_VERSION=2023-06-01
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=700
CLAUDE_TEMPERATURE=0.35
CLAUDE_DAILY_CHAT_LIMIT=100
CLAUDE_TOOL_MAX_CALLS=3
CHAT_RATE_LIMIT_PER_MINUTE=10
MAX_CHAT_HISTORY_MESSAGES=12
DRAFT_DAILY_LIMIT=100

TRIPLE_WHALE_API_BASE_URL=https://api.triplewhale.com
TRIPLE_WHALE_VALIDATE_PATH=/api/v2/users/api-keys/me
TRIPLE_WHALE_SUMMARY_PATH=/api/v2/summary-page/get-data
TRIPLE_WHALE_SUMMARY_BODY_JSON=
TRIPLE_WHALE_SHOP_DOMAIN=your-shop-domain.com
TRIPLE_WHALE_ADDITIONAL_SHOP_IDS=your-shop-domain.com
TRIPLE_WHALE_CURRENCY=USD
TRIPLE_WHALE_TIMEZONE=America/New_York
TRIPLE_WHALE_TIMEZONE_OFFSET=-04:00
TRIPLE_WHALE_SUMMARY_DATE=
TRIPLE_WHALE_SUMMARY_GROUP_BY=hour
TRIPLE_WHALE_TODAY_HOUR=

TRIPLE_WHALE_ATTRIBUTION_PATH=/api/v2/attribution/get-orders-with-journeys-v2
TRIPLE_WHALE_ATTRIBUTION_BODY_JSON=
TRIPLE_WHALE_ATTRIBUTION_DATE=
TRIPLE_WHALE_ATTRIBUTION_PAGE=1
TRIPLE_WHALE_ATTRIBUTION_PAGE_SIZE=25
TRIPLE_WHALE_ATTRIBUTION_EXCLUDE_JOURNEY_DATA=true

WORKER_SHARED_SECRET=replace_with_long_random_worker_secret_32_chars_minimum
WORKER_API_BASE_URL=http://localhost:4000
WORKER_ENABLED=false
WORKER_TIMEZONE=America/New_York
WORKER_METRICS_CRON=15 * * * *
WORKER_DAILY_BRIEF_CRON=30 8 * * *
WORKER_WEEKLY_SUMMARY_CRON=0 9 * * 1
WORKER_WORKSPACE_ID=
WORKER_USER_ID=
