# LIFE.SAVER GitHub Actions / CI example
# Do not place real production secrets in this file.
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000/landing.html
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin.html
API_URL=http://localhost:4000
PRODUCT_SURFACE_MODE=single-service-local
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=
DATABASE_SSL=false
AUTH_TOKEN_SECRET=replace_with_ci_only_non_production_secret_40_chars
APP_ENCRYPTION_KEY=replace_with_ci_only_non_production_secret_32_chars
WORKER_SHARED_SECRET=replace_with_ci_only_non_production_secret_40_chars
CLAUDE_API_KEY=
TRIPLE_WHALE_API_BASE_URL=https://api.triplewhale.com
TRIPLE_WHALE_SHOP_DOMAIN=budclub.com
TRIPLE_WHALE_ADDITIONAL_SHOP_IDS=budclub.com
TRIPLE_WHALE_CURRENCY=USD
TRIPLE_WHALE_TIMEZONE=America/New_York
TRIPLE_WHALE_TIMEZONE_OFFSET=-04:00
WORKER_API_BASE_URL=http://localhost:4000
WORKER_ENABLED=false
