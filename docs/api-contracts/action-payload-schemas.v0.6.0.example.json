{
  "registry_version": "v0.6.0-phase-2.4",
  "schema_version": "action-payload/v0.6.0",
  "status": "definition_only_no_execution",
  "safety": {
    "payloads_describe_intent_only": true,
    "approval_does_not_mean_execution": true,
    "executors_not_added_in_this_phase": true,
    "forbidden_payload_keys": [
      "api_key",
      "apikey",
      "access_token",
      "refresh_token",
      "password",
      "secret",
      "cookie",
      "authorization",
      "database_url",
      "DATABASE_URL",
      "CLAUDE_API_KEY",
      "TRIPLE_WHALE_API_KEY",
      "APP_ENCRYPTION_KEY",
      "WORKER_SHARED_SECRET"
    ]
  },
  "common_envelope": {
    "required": [
      "schema_version",
      "action_type",
      "source",
      "intent_summary",
      "data"
    ],
    "properties": {
      "schema_version": {
        "type": "string",
        "const": "action-payload/v0.6.0"
      },
      "action_type": {
        "type": "string"
      },
      "source": {
        "type": "string",
        "enum": [
          "chat",
          "draft",
          "worker",
          "admin",
          "policy",
          "system",
          "import"
        ]
      },
      "intent_summary": {
        "type": "string",
        "maxLength": 280
      },
      "created_reason": {
        "type": [
          "string",
          "null"
        ]
      },
      "risk_notes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "idempotency_hint": {
        "type": [
          "string",
          "null"
        ]
      },
      "data": {
        "type": "object"
      }
    }
  },
  "action_payloads": {
    "content_publish": {
      "default_approval_required": true,
      "future_auto_run_eligible": "only_after_policy_pause_caps_content_risk_and_sandbox_pass",
      "required_data_fields": [
        "platform",
        "caption"
      ],
      "optional_data_fields": [
        "post_type",
        "media_url",
        "media_asset_id",
        "hashtags",
        "scheduled_time",
        "account_id_hint",
        "call_to_action_url",
        "approval_notes",
        "brand_voice_profile_id"
      ],
      "example_data": {
