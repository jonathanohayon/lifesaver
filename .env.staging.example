NODE_ENV=production
APP_ENVIRONMENT=staging
DATABASE_ENVIRONMENT=staging
ENVIRONMENT_LOCK=staging:staging
PORT=4000
FRONTEND_URL=https://staging-app.your-domain.com
PUBLIC_SITE_URL=https://yourdomain.com
APP_URL=https://app.yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
API_URL=https://api.yourdomain.com
PRODUCT_SURFACE_MODE=subdomain-production-ready
DOMAIN_DEPLOYMENT_MODE=split-subdomain-production
CUSTOMER_ACCESS_MODE=private-beta
CUSTOMER_LAUNCH_DOMAIN_LABEL=LIFE.SAVER Private Beta
ALLOWED_ORIGINS=https://staging-app.your-domain.com
DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_HOST:5432/postgres
DATABASE_SSL=true
PRODUCTION_DATABASE_URL=
AUTH_TOKEN_SECRET=generate_a_long_random_staging_secret
APP_ENCRYPTION_KEY=generate_a_long_random_staging_encryption_key_and_keep_it_stable
WORKER_SHARED_SECRET=generate_a_long_random_staging_worker_secret
CLAUDE_API_KEY=
TRIPLE_WHALE_API_BASE_URL=https://api.triplewhale.com
TRIPLE_WHALE_SHOP_DOMAIN=budclub.com
TRIPLE_WHALE_CURRENCY=USD
TRIPLE_WHALE_TIMEZONE=America/New_York
TRIPLE_WHALE_TIMEZONE_OFFSET=-04:00
DASHBOARD_REQUIRE_AUTH=true
CHAT_REQUIRE_AUTH=true
ENABLE_DEBUG_ROUTES=false
ALLOW_INSECURE_PRODUCTION_STARTUP=false

SAAS_SIGNUP_ENABLED=true
